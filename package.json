{
  "name": "codapter",
  "version": "0.0.4",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": {
    "node": "^22.22.1 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "build:dist": "npm run build && node scripts/build-dist.mjs",
    "check": "npm run build:dist && npm run lint && npm run test",
    "gui:audit:collect": "node scripts/gui-audit.mjs collect",
    "gui:audit:compare": "node scripts/gui-audit.mjs compare",
    "lint": "biome check --error-on-warnings .",
    "prepare": "husky",
    "test": "vitest run",
    "test:smoke": "vitest run test/smoke/",
    "test:live": "npm run build:dist && PI_LIVE_TEST=1 vitest run test/smoke/pi-live.smoke.test.ts"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,json,md}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
